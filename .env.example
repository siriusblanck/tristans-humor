# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase secret key: writes AI generations, which signed-in users cannot write directly.
SUPABASE_SECRET_KEY=sb_secret_...
# Google AI Studio key on a project with billing enabled (image models have no free tier).
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides.
# GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
